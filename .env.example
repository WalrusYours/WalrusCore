# Copy to .env. Compose reads it automatically. .env is gitignored: it holds secrets.
#
# Every value below has a development default, so `docker compose up` works without a .env. The
# defaults are public: set your own admin key and Neo4j password for anything that is not a local
# try-out, and never combine the default key with WALRUS_BIND=0.0.0.0.

# Compose uses these when unset:
# WALRUS_ADMIN_KEY=walrus-dev-key        sign in to the dashboard with it
# NEO4J_PASSWORD=walrus-dev-password     min 8 characters; applied only when the walrus-neo4j volume is
#                                        first created, change it later with `docker compose down -v`
#                                        (wipes the data)
# WALRUS_INSTANCE_NAME=walrus
# DOCKERHUB_USERNAME=timurcravtov         the Docker Hub account the release workflows publish to

WALRUS_ADMIN_KEY=change-me-long-random
NEO4J_PASSWORD=change-me-too-long-random

# Optional.
# WALRUS_VERSION=latest
# DASHBOARD_VERSION=latest
# REGISTRY_URL=docker.io
# WALRUS_BIND=127.0.0.1
# WALRUS_PORT=8080
# DASHBOARD_PORT=3001
